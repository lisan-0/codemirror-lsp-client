@charset "utf-8";

:root { color-scheme: dark; --bg: #101318; --panel: #191f27; --line: #2a3440; --muted: #9aa8b7; --gold: #f5a623; --green: #4ade80; }

* { box-sizing: border-box; }

body { margin: 0px; background: radial-gradient(circle at 85% 0,#242b35 0,transparent 35%),var(--bg); color: rgb(245, 247, 250); font: 16px system-ui, -apple-system, "Segoe UI", sans-serif; }

main { max-width: 980px; margin: auto; padding: 28px 18px 56px; }

.top { display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; }

.brand { display: flex; align-items: center; gap: 12px; }

.coin { width: 44px; height: 44px; border-radius: 14px; background: rgb(51, 39, 18); color: var(--gold); display: grid; place-items: center; font-size: 25px; font-weight: 800; }

h1 { font-size: 23px; margin: 0px; letter-spacing: 0.08em; }

small, .muted { color: var(--muted); }

.pill { border: 1px solid rgb(121, 91, 40); color: rgb(255, 209, 122); border-radius: 99px; padding: 7px 11px; font-size: 12px; }

h2 { font-size: 17px; margin: 0px 0px 14px; }

.hero { margin: 28px 0px 16px; padding: 24px; border: 1px solid var(--line); border-radius: 20px; background: linear-gradient(120deg, rgb(32, 40, 51), rgb(23, 29, 37)); }

.label { color: var(--muted); font-size: 13px; }

.balance { font-size: clamp(28px, 7vw, 42px); font-weight: 750; margin: 8px 0px; }

.note { font-size: 13px; color: rgb(185, 195, 206); line-height: 1.55; }

.grid { display: grid; grid-template-columns: repeat(3, minmax(0px, 1fr)); gap: 12px; }

.card { background: var(--panel); border: 1px solid var(--line); border-radius: 16px; padding: 17px; min-width: 0px; }

.value { font-size: 22px; font-weight: 700; margin-top: 8px; overflow-wrap: anywhere; }

.unit { font-size: 12px; color: var(--muted); font-weight: 500; }

section { margin-top: 22px; }

.status { display: flex; gap: 10px; align-items: flex-start; }

.dot { width: 9px; height: 9px; border-radius: 50%; background: rgb(251, 191, 36); margin-top: 6px; flex: 0 0 auto; }

.actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 15px; }

button { border: 1px solid var(--line); background: rgb(37, 47, 59); color: rgb(255, 255, 255); border-radius: 11px; padding: 11px 14px; font: inherit; cursor: pointer; }

button.primary { background: var(--gold); border-color: var(--gold); color: rgb(23, 23, 23); font-weight: 700; }

input { width: 100%; padding: 12px; border-radius: 10px; border: 1px solid var(--line); background: rgb(16, 22, 29); color: rgb(255, 255, 255); margin: 8px 0px; }

footer { margin-top: 28px; border-top: 1px solid var(--line); padding-top: 18px; color: var(--muted); font-size: 12px; line-height: 1.6; }

#app { display: none; }

#auth { max-width: 480px; margin: 38px auto 0px; }

#auth .card { padding: 22px; }

#auth input { margin: 7px 0px 13px; }

#authmsg { min-height: 20px; font-size: 13px; color: rgb(255, 209, 122); }

@media (max-width: 650px) {
  .grid { grid-template-columns: 1fr 1fr; }
  .hero { padding: 20px; }
  .card { padding: 14px; }
}

@media (max-width: 390px) {
  .grid { grid-template-columns: 1fr; }
}
